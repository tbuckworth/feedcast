# The keys the pipeline reads from its environment. Nothing loads a .env file:
# export these yourself, or on the desktop run under bwsrun (.bws-profile).
# README.md's environment table says what each is for; ROLES in src/llm.py
# says which models each LLM account serves.
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
DEEPINFRA_API_KEY=...
